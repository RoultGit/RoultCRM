generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // En serverless cada invocación puede abrir su propia conexión, y Postgres se queda sin cupo
  // enseguida. DATABASE_URL apunta al pooler de Supabase (puerto 6543, pgbouncer=true) y DIRECT_URL
  // a la conexión directa (5432), que es la única que sirve para correr migraciones.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  VENDEDOR
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  users User[]
  apiKeys ApiKey[]
  customFields CustomField[]
}

model User {
  id             String     @id @default(uuid())
  tenantId       String
  tenant         Tenant     @relation(fields: [tenantId], references: [id])
  email          String
  passwordHash   String
  firstName      String
  lastName       String
  role           UserRole
  status         UserStatus @default(ACTIVE)
  phone          String?
  avatarUrl      String?
  // Dueño de la plataforma: quien vende el CRM y da de alta las empresas cliente. Es una bandera
  // y NO un rol nuevo a propósito. Con un tercer valor en UserRole, los ~15 chequeos de
  // `role === 'ADMIN'` que ya existen dejarían afuera al dueño sin avisar, y hay que acordarse de
  // los quince. Así el dueño sigue siendo ADMIN de su propia empresa y solo suma este permiso.
  isPlatformOwner Boolean   @default(false)
  // Contraseña provisoria pendiente de cambiar. Toda contraseña que genera el sistema y viaja por
  // WhatsApp o correo nace marcada: quien entra la cambia antes de poder usar la app. Sin esto, la
  // contraseña que el vendedor le pasó al cliente queda viva para siempre en un chat.
  mustChangePassword Boolean @default(false)
  // Cuándo se le mandó el último resumen diario. Es la guarda contra mandar dos veces el mismo
  // correo si el cron corre dos veces en el día.
  lastDigestAt   DateTime?
  commissionPct  Decimal    @default(20) @db.Decimal(5, 2)
  hireDate       DateTime   @default(now())
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  refreshTokens RefreshToken[]
  passwordResets PasswordResetToken[]

  // Único POR EMPRESA, no en el mundo. Con el índice global, una persona pertenecía a una sola
  // empresa: un contador que atiende a dos clientes no podía usar su correo en las dos, y el dueño
  // que tiene dos negocios necesitaba dos casillas. Es la restricción que impide crecer.
  @@unique([tenantId, email])
  @@index([tenantId])
  // El login busca por correo sin saber todavía de qué empresa es, así que necesita su propio índice.
  @@index([email])
}

model RefreshToken {
  id         String    @id @default(uuid())
  tenantId   String
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  tokenHash  String    @unique
  userAgent  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([tenantId])
}

// Token de "olvidé mi contraseña". Se guarda HASHEADO, igual que el refresh token: si alguien lee
// la base, no puede usar los tokens vivos para tomar cuentas ajenas. Lo que viaja por correo es el
// valor en claro, que no existe en ningún lado más.
model PasswordResetToken {
  id        String    @id @default(uuid())
  tenantId  String
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  // Un solo uso. Sin esto, el link que quedó en la bandeja de entrada sirve para siempre, y el
  // correo es justamente lo que se compromete cuando alguien pierde el control de su cuenta.
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Clave para que un sistema de afuera —el formulario de la web, un chatbot, Zapier— cargue leads
// sin una sesión de usuario. Se guarda HASHEADA: si alguien lee la base, no puede usarla.
model ApiKey {
  id         String    @id @default(uuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  name       String
  keyHash    String    @unique
  // Últimos 4 caracteres, para poder reconocerla en la lista sin guardarla entera.
  lastFour   String
  createdById String
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([tenantId])
}

// Qué campo extra definió cada empresa. Una inmobiliaria necesita "metros cuadrados", una clínica
// "número de historia clínica": no hay forma de anticiparlos, y agregarlos como columnas obligaría a
// migrar la base por cada cliente nuevo.
enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  SELECT
  CHECKBOX
}

model CustomField {
  id          String          @id @default(uuid())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  // A qué ficha se le agrega: empresa, contacto, lead o venta.
  entity      RelatedType
  label       String
  type        CustomFieldType
  // Opciones del desplegable. Vacío para los demás tipos.
  options     String[]        @default([])
  required    Boolean         @default(false)
  // Para ordenarlos en el formulario sin depender de cuándo se crearon.
  position    Int             @default(0)
  archivedAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  values CustomFieldValue[]

  @@index([tenantId, entity, archivedAt])
}

// El valor guardado, siempre como texto.
//
// Un solo campo `value` en vez de una columna por tipo: el tipo lo valida el schema al escribir, y
// tener valueText/valueNumber/valueDate obligaría a saber cuál mirar en cada lectura. Lo que se
// gana en pureza se paga en cada consulta.
model CustomFieldValue {
  id       String      @id @default(uuid())
  tenantId String
  fieldId  String
  field    CustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  // Polimórfico, igual que Activity: el mismo campo puede colgar de cualquier ficha.
  entity   RelatedType
  recordId String
  value    String

  // Un valor por campo y por ficha: sin esto, guardar dos veces dejaría dos filas y la lectura
  // tendría que elegir una al azar.
  @@unique([fieldId, recordId])
  @@index([tenantId, entity, recordId])
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String
  // userId sin @relation, mismo criterio que tenantId en el resto del schema. Un log de auditoría
  // es un registro histórico: no puede depender de que la fila del usuario siga existiendo, ni
  // bloquear su borrado, ni desaparecer con él. El nombre se resuelve en la capa de aplicación.
  userId     String
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([tenantId, entityType, entityId])
}

enum Line {
  WEB
  SOFTWARE
  AUTOMATIZACION
  SERVICIO
}

// Qué se cobra: una vez, o todos los meses. No es un detalle del monto sino su unidad — 8000 de
// pago único y 8000 al mes son números incomparables, y sumarlos daría un total que no existe.
// Mismo criterio que PEN y USD: nunca se mezclan.
enum BillingType {
  ONE_TIME
  MONTHLY
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  UNQUALIFIED
  LOST
}

model Company {
  id             String   @id @default(uuid())
  tenantId       String
  name           String
  // Quién firma y con quién se habla en serio. En Perú es el representante legal del RUC, y es dato
  // distinto del contacto operativo del día a día, que vive en Contact.
  representativeName String?
  line           Line
  city           String?
  source         String?
  whatsapp       String?
  email          String?
  assignedUserId String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  contacts           Contact[]
  convertedFromLeads Lead[]    @relation("LeadConvertedCompany")
  deals              Deal[]

  @@index([tenantId])
}

model Contact {
  id         String   @id @default(uuid())
  tenantId   String
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  name       String
  position   String?
  phone      String?
  whatsapp   String?
  email      String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId])
  @@index([companyId])
}

model Lead {
  id                 String     @id @default(uuid())
  tenantId           String
  businessName       String
  // contactName es quien atendió el teléfono; representativeName es quien firma. Pueden ser la
  // misma persona, pero cuando no lo son, perder el segundo cuesta la venta.
  contactName        String
  representativeName String?
  phone              String?
  whatsapp           String?
  email              String?
  line               Line
  source             String?
  assignedUserId     String?
  billingType        BillingType @default(ONE_TIME)
  status             LeadStatus @default(NEW)
  notes              String?
  convertedCompanyId String?
  convertedCompany   Company?   @relation("LeadConvertedCompany", fields: [convertedCompanyId], references: [id])
  convertedAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([tenantId])
  @@index([tenantId, status])
}

enum Currency {
  PEN
  USD
}

enum DealStage {
  CONTACTO
  PROPUESTA
  NEGOCIACION
  ADELANTO
  PRODUCCION
  ENTREGADO
  MANTENIMIENTO
  PERDIDO
}

enum RelatedType {
  LEAD
  COMPANY
  DEAL
  CONTACT
}

// Qué pasó con un cliente: la llamada, la reunión, el mensaje. Es el corazón de un CRM — sin esto,
// el sistema sabe QUIÉN es el cliente pero no QUÉ pasó con él, y cada vendedor guarda esa historia
// en su cabeza o en su WhatsApp. Cuando se va, la empresa la pierde.
enum ActivityType {
  NOTE
  CALL
  MEETING
  WHATSAPP
  EMAIL
  VISIT
}

model Activity {
  id          String       @id @default(uuid())
  tenantId    String
  // Sin @relation, igual que AuditLog: es historia y no puede desaparecer ni bloquear el borrado
  // si la persona deja la empresa. El nombre se resuelve en la aplicación.
  authorId    String
  // Polimórfico a propósito: una interacción es la misma cosa sea contra un lead, un cliente, un
  // contacto o una venta. Cuatro tablas casi idénticas serían cuatro lugares donde arreglar lo mismo.
  relatedType RelatedType
  relatedId   String
  type        ActivityType
  body        String
  // Cuándo pasó, que NO es cuándo se cargó: una llamada del viernes se anota el lunes, y ordenar
  // por fecha de carga contaría la historia en el orden equivocado.
  occurredAt  DateTime
  createdAt   DateTime     @default(now())

  @@index([tenantId, relatedType, relatedId, occurredAt])
}

model Deal {
  id                  String    @id @default(uuid())
  tenantId            String
  companyId           String
  company             Company   @relation(fields: [companyId], references: [id])
  title               String
  amount              Decimal   @db.Decimal(12, 2)
  currency            Currency
  // ONE_TIME: `amount` es el total. MONTHLY: `amount` es lo que se cobra CADA MES.
  billingType         BillingType @default(ONE_TIME)
  stage               DealStage @default(CONTACTO)
  assignedUserId      String?
  expectedCloseDate   DateTime?
  lostReason          String?
  nextStepDescription String?
  nextStepOwnerId     String?
  nextStepDate        DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([tenantId])
  @@index([tenantId, stage])
  @@index([tenantId, assignedUserId])
  @@index([companyId])
}

enum TaskStatus {
  TODO
  DOING
  DONE
}

// El orden de declaración importa: Postgres ordena los enum por él, así que 'asc' da de lo más
// urgente a lo menos, que es como se quiere leer una lista de pendientes.
enum TaskPriority {
  URGENT
  HIGH
  MEDIUM
  LOW
}

model Task {
  id          String       @id @default(uuid())
  tenantId    String
  title       String
  description String?
  ownerId     String
  relatedType RelatedType?
  relatedId   String?
  dueDate     DateTime
  // dueDate sigue siendo medianoche UTC, como el resto de las fechas del sistema. La hora va aparte
  // como "HH:mm" y es opcional: null significa "todo el día", que es como el calendario la ubica en
  // su fila de arriba en vez de en una hora concreta. Guardarla dentro de dueDate habría metido
  // zona horaria en una columna que todo el código trata como fecha pelada.
  dueTime     String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  // Quién la creó. Nullable SOLO por las tareas que ya existían: no hay forma de saber quién las
  // creó, y rellenarlas con el dueño sería inventar el dato. De acá en adelante siempre viene.
  createdById String?
  // Quién la cerró y cuándo. Se llena al pasar a DONE y se LIMPIA al reabrirla: una tarea en "Por
  // hacer" que siga diciendo "completada por Ana" es peor que no decir nada.
  completedById String?
  completedAt   DateTime?
  // Cuánto va hecho, de 0 a 100. El rango se valida en el schema compartido, no solo acá: la base
  // acepta cualquier entero y un -20 o un 500 romperían la barra de progreso en silencio.
  progress    Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  updates TaskUpdate[]

  @@index([tenantId])
  @@index([tenantId, ownerId, status])
  @@index([tenantId, completedById])
}

// Cada avance registrado sobre una tarea: qué se hizo y en cuánto quedó. El progreso deja de ser
// un número suelto que alguien pisa y pasa a tener historia — se puede ver quién movió la aguja,
// cuándo y por qué. Task.progress guarda el último valor para no tener que recorrer los avances
// cada vez que se dibuja una tarjeta.
model TaskUpdate {
  id        String   @id @default(uuid())
  tenantId  String
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  // Sin @relation, mismo criterio que AuditLog: es un registro histórico y no puede desaparecer
  // ni bloquear el borrado si la persona deja la empresa. El nombre se resuelve en la app.
  authorId  String
  note      String
  progress  Int
  createdAt DateTime @default(now())

  @@index([tenantId, taskId, createdAt])
}

model AssignmentHistory {
  id             String      @id @default(uuid())
  tenantId       String
  entityType     RelatedType
  entityId       String
  previousUserId String?
  newUserId      String?
  changedById    String
  changedAt      DateTime    @default(now())

  @@index([tenantId, entityType, entityId])
}
