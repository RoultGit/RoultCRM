generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // En serverless cada invocación puede abrir su propia conexión, y Postgres se queda sin cupo
  // enseguida. DATABASE_URL apunta al pooler de Supabase (puerto 6543, pgbouncer=true) y DIRECT_URL
  // a la conexión directa (5432), que es la única que sirve para correr migraciones.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  VENDEDOR
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  users User[]
}

model User {
  id             String     @id @default(uuid())
  tenantId       String
  tenant         Tenant     @relation(fields: [tenantId], references: [id])
  email          String     @unique
  passwordHash   String
  firstName      String
  lastName       String
  role           UserRole
  status         UserStatus @default(ACTIVE)
  phone          String?
  avatarUrl      String?
  // Dueño de la plataforma: quien vende el CRM y da de alta las empresas cliente. Es una bandera
  // y NO un rol nuevo a propósito. Con un tercer valor en UserRole, los ~15 chequeos de
  // `role === 'ADMIN'` que ya existen dejarían afuera al dueño sin avisar, y hay que acordarse de
  // los quince. Así el dueño sigue siendo ADMIN de su propia empresa y solo suma este permiso.
  isPlatformOwner Boolean   @default(false)
  commissionPct  Decimal    @default(20) @db.Decimal(5, 2)
  hireDate       DateTime   @default(now())
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  refreshTokens RefreshToken[]

  @@index([tenantId])
}

model RefreshToken {
  id         String    @id @default(uuid())
  tenantId   String
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  tokenHash  String    @unique
  userAgent  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([tenantId])
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String
  // userId sin @relation, mismo criterio que tenantId en el resto del schema. Un log de auditoría
  // es un registro histórico: no puede depender de que la fila del usuario siga existiendo, ni
  // bloquear su borrado, ni desaparecer con él. El nombre se resuelve en la capa de aplicación.
  userId     String
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([tenantId, entityType, entityId])
}

enum Line {
  WEB
  SOFTWARE
  AUTOMATIZACION
  SERVICIO
}

// Qué se cobra: una vez, o todos los meses. No es un detalle del monto sino su unidad — 8000 de
// pago único y 8000 al mes son números incomparables, y sumarlos daría un total que no existe.
// Mismo criterio que PEN y USD: nunca se mezclan.
enum BillingType {
  ONE_TIME
  MONTHLY
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  UNQUALIFIED
  LOST
}

model Company {
  id             String   @id @default(uuid())
  tenantId       String
  name           String
  // Quién firma y con quién se habla en serio. En Perú es el representante legal del RUC, y es dato
  // distinto del contacto operativo del día a día, que vive en Contact.
  representativeName String?
  line           Line
  city           String?
  source         String?
  whatsapp       String?
  email          String?
  assignedUserId String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  contacts           Contact[]
  convertedFromLeads Lead[]    @relation("LeadConvertedCompany")
  deals              Deal[]

  @@index([tenantId])
}

model Contact {
  id         String   @id @default(uuid())
  tenantId   String
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  name       String
  position   String?
  phone      String?
  whatsapp   String?
  email      String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId])
  @@index([companyId])
}

model Lead {
  id                 String     @id @default(uuid())
  tenantId           String
  businessName       String
  // contactName es quien atendió el teléfono; representativeName es quien firma. Pueden ser la
  // misma persona, pero cuando no lo son, perder el segundo cuesta la venta.
  contactName        String
  representativeName String?
  phone              String?
  whatsapp           String?
  email              String?
  line               Line
  source             String?
  assignedUserId     String?
  billingType        BillingType @default(ONE_TIME)
  status             LeadStatus @default(NEW)
  notes              String?
  convertedCompanyId String?
  convertedCompany   Company?   @relation("LeadConvertedCompany", fields: [convertedCompanyId], references: [id])
  convertedAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([tenantId])
  @@index([tenantId, status])
}

enum Currency {
  PEN
  USD
}

enum DealStage {
  CONTACTO
  PROPUESTA
  NEGOCIACION
  ADELANTO
  PRODUCCION
  ENTREGADO
  MANTENIMIENTO
  PERDIDO
}

enum RelatedType {
  LEAD
  COMPANY
  DEAL
}

model Deal {
  id                  String    @id @default(uuid())
  tenantId            String
  companyId           String
  company             Company   @relation(fields: [companyId], references: [id])
  title               String
  amount              Decimal   @db.Decimal(12, 2)
  currency            Currency
  // ONE_TIME: `amount` es el total. MONTHLY: `amount` es lo que se cobra CADA MES.
  billingType         BillingType @default(ONE_TIME)
  stage               DealStage @default(CONTACTO)
  assignedUserId      String?
  expectedCloseDate   DateTime?
  lostReason          String?
  nextStepDescription String?
  nextStepOwnerId     String?
  nextStepDate        DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([tenantId])
  @@index([tenantId, stage])
  @@index([tenantId, assignedUserId])
  @@index([companyId])
}

enum TaskStatus {
  TODO
  DOING
  DONE
}

model Task {
  id          String       @id @default(uuid())
  tenantId    String
  title       String
  description String?
  ownerId     String
  relatedType RelatedType?
  relatedId   String?
  dueDate     DateTime
  // dueDate sigue siendo medianoche UTC, como el resto de las fechas del sistema. La hora va aparte
  // como "HH:mm" y es opcional: null significa "todo el día", que es como el calendario la ubica en
  // su fila de arriba en vez de en una hora concreta. Guardarla dentro de dueDate habría metido
  // zona horaria en una columna que todo el código trata como fecha pelada.
  dueTime     String?
  status      TaskStatus   @default(TODO)
  // Cuánto va hecho, de 0 a 100. El rango se valida en el schema compartido, no solo acá: la base
  // acepta cualquier entero y un -20 o un 500 romperían la barra de progreso en silencio.
  progress    Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([tenantId])
  @@index([tenantId, ownerId, status])
}

model AssignmentHistory {
  id             String      @id @default(uuid())
  tenantId       String
  entityType     RelatedType
  entityId       String
  previousUserId String?
  newUserId      String?
  changedById    String
  changedAt      DateTime    @default(now())

  @@index([tenantId, entityType, entityId])
}
