# ── Backend (apps/api) ────────────────────────────────────────────────────────
# Pooler de Supabase (puerto 6543). Es la que usa la app en runtime.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Conexión directa (puerto 5432). Solo para `prisma migrate`.
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Generar con: openssl rand -base64 48
JWT_ACCESS_SECRET="<secreto largo y aleatorio>"
JWT_REFRESH_PEPPER="<otro secreto largo y aleatorio, distinto del anterior>"

# Orígenes permitidos, separados por coma (producción y previews).
WEB_ORIGIN="https://roult-crm.vercel.app"

# Solo para el seed inicial. Cambiar la contraseña al primer ingreso.
ADMIN_TENANT_NAME="ROUlt"
ADMIN_EMAIL="admin@roult.pe"
ADMIN_PASSWORD="<contraseña inicial del admin>"

# ── Frontend (apps/web) ───────────────────────────────────────────────────────
VITE_API_URL="https://roult-crm.vercel.app"
